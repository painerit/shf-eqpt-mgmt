<% page_title "Вход" %>

<div class="auth-card">
  <div class="auth-card__header">
    <span class="brand__mark brand__mark--large">СВЧ</span>
    <h1>Вход в систему</h1>
    <p>Управление поверкой СВЧ-оборудования</p>
  </div>

  <%= form_with url: login_path, method: :post, local: true, class: "form" do |form| %>
    <div class="field">
      <%= form.label :email, "Электронная почта" %>
      <%= form.email_field :email, value: @email, autofocus: true, autocomplete: "email", required: true %>
    </div>

    <div class="field">
      <%= form.label :password, "Пароль" %>
      <%= form.password_field :password, autocomplete: "current-password", required: true %>
    </div>

    <%= form.submit "Войти", class: "btn btn--primary btn--block" %>
  <% end %>

  <div class="auth-card__footer">
    <span>Нет аккаунта?</span>
    <%= link_to "Зарегистрироваться", signup_path %>
  </div>

  <div class="auth-card__hint">
    <strong>Демо-доступ:</strong> admin@example.com / password123
  </div>
</div>