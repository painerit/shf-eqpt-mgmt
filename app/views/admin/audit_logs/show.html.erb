<% page_title "Запись аудита ##{@audit_log.id}" %>

<div class="page-header">
  <div>
    <div class="page-header__breadcrumb">
      <%= link_to "Аудит", admin_audit_logs_path %> / Запись #<%= @audit_log.id %>
    </div>
    <h1>Запись аудита</h1>
    <p><%= auditable_type_label(@audit_log.auditable_type) %> #<%= @audit_log.auditable_id %></p>
  </div>
  <div class="page-header__actions">
    <%= link_to "К журналу", admin_audit_logs_path, class: "btn btn--ghost" %>
    <% if @audit_log.auditable.present? %>
      <%= link_to "Открыть объект", polymorphic_path(@audit_log.auditable), class: "btn" %>
    <% end %>
  </div>
</div>

<section class="card">
  <div class="detail-grid">
    <div class="detail-item">
      <span class="detail-item__label">Дата</span>
      <span class="detail-item__value"><%= human_datetime(@audit_log.created_at) %></span>
    </div>
    <div class="detail-item">
      <span class="detail-item__label">Пользователь</span>
      <span class="detail-item__value"><%= @audit_log.user&.display_name || "Система" %></span>
    </div>
    <div class="detail-item">
      <span class="detail-item__label">Действие</span>
      <span class="detail-item__value"><%= audit_action_label(@audit_log.action) %></span>
    </div>
    <div class="detail-item">
      <span class="detail-item__label">Объект</span>
      <span class="detail-item__value">
        <%= auditable_type_label(@audit_log.auditable_type) %> #<%= @audit_log.auditable_id %>
      </span>
    </div>
    <div class="detail-item">
      <span class="detail-item__label">IP-адрес</span>
      <span class="detail-item__value"><%= @audit_log.ip_address.presence || "—" %></span>
    </div>
    <div class="detail-item">
      <span class="detail-item__label">User-Agent</span>
      <span class="detail-item__value"><%= @audit_log.user_agent.presence || "—" %></span>
    </div>
  </div>
</section>

<section class="card">
  <header class="card__header">
    <h2>Изменения</h2>
  </header>

  <% if @audit_log.audited_changes.any? %>
    <pre class="json-block"><%= JSON.pretty_generate(@audit_log.audited_changes) %></pre>
  <% else %>
    <div class="empty-state">
      <strong>Изменения не зафиксированы</strong>
      <span>Для этой записи нет детализированных данных.</span>
    </div>
  <% end %>
</section>