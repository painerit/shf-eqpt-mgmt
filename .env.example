# Rails
RAILS_ENV=development
RAILS_MAX_THREADS=5
RAILS_LOG_TO_STDOUT=true

# Database
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=password

# Master key for config/credentials.yml.enc (never commit the real value)
RAILS_MASTER_KEY=

# JWT secret for the REST API. Falls back to Rails secret_key_base when empty.
JWT_SECRET=

# External verification registry API
REGISTRY_API_BASE_URL=
REGISTRY_API_TOKEN=
REGISTRY_API_FAKE=true
REGISTRY_API_FAKE_FAIL=false